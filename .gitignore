.env
.env.*
!.env.example
*.env
secrets/
secret*.json
credentials*.json
client_secret*.json
service-account*.json
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks
*.keystore
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
.npmrc
.pypirc
.netrc
config.local.*
application-local.properties
application-local.yml
application-secret*.properties
application-secret*.yml

